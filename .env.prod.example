# ============================================
# PRODUCTION ENVIRONMENT VARIABLES (.env.prod)
# ============================================
# Use this for production deployments
# Set these in your hosting platform (AWS, Azure, Docker, K8s, etc.)

# Database Configuration (use cloud-managed DB)
DB_URL=jdbc:mysql://prod-db-host:3306/healthcaredb?sessionVariables=FOREIGN_KEY_CHECKS=0
DB_USERNAME=prod_db_user
DB_PASSWORD=very-strong-production-password

# JWT Configuration (use a strong, randomly generated secret)
JWT_SECRET=your-production-jwt-secret-key-must-be-very-secure-and-random

# OAuth2 Configuration (Google)
OAUTH_CLIENT_ID=your-production-google-client-id
OAUTH_CLIENT_SECRET=your-production-google-client-secret

# OAuth Redirect URIs
OAUTH_REDIRECT_URI=https://yourdomain.com/oauth2/redirect
OAUTH_CALLBACK_URI=https://api.yourdomain.com/api/auth/oauth2/callback

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Email Configuration (consider using SendGrid or AWS SES for production)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-production-email@gmail.com
MAIL_PASSWORD=your-production-email-app-password

# File Upload Configuration
FILE_UPLOAD_DIR=/var/www/uploads/profile-pictures/

# Server Profile
SPRING_PROFILES_ACTIVE=prod
