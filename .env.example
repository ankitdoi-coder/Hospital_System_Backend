# ============================================
# DEVELOPMENT ENVIRONMENT VARIABLES (.env)
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!
# This file has PLACEHOLDER values only

# Database Configuration
DB_PASSWORD=your-db-password

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-min-32-chars-for-security

# OAuth2 Configuration (Google)
# Get these from: https://console.cloud.google.com/
OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OAUTH_CLIENT_SECRET=your-google-client-secret

# Email Configuration
# For Gmail: Use app-specific password from https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# Server Profile
SPRING_PROFILES_ACTIVE=dev
